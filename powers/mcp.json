{
  "mcpServers": {
    "fetch": {
      "command": "uvx",
      "args": ["mcp-server-fetch@latest"],
      "disabled": false
    },
    "git": {
      "command": "uvx",
      "args": ["mcp-server-git@latest", "--repository", "."],
      "disabled": false
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem@latest",
        "."
      ],
      "disabled": false
    }
  }
}
